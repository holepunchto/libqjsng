+/* Creates a BigInt from the 'len' 64-bit words of its magnitude, ordered
+   from least to most significant, negated if 'sign' is non-zero. */
+JS_EXTERN JSValue JS_NewBigIntWords(JSContext *ctx, int sign,
+                                    const uint64_t *words, size_t len);
+/* Gets the sign of a BigInt and the 64-bit words of its magnitude, ordered
+   from least to most significant. At most '*plen' words are written to
+   'words', which may be NULL, and '*plen' is then set to the number of words
+   in the magnitude. Returns -1 if 'val' is not a BigInt. */
+JS_EXTERN int JS_ToBigIntWords(JSContext *ctx, JSValueConst val, int *psign,
+                               uint64_t *words, size_t *plen);
 /* same as JS_ToInt64() but allow BigInt */
