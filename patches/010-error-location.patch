@@ -8232,6 +8237,114 @@ static bool can_store_error_stack(JSValueConst obj)
 #define JS_BACKTRACE_FLAG_SINGLE_LEVEL     (1 << 1)
 #define JS_BACKTRACE_FLAG_FILTER_FUNC      (1 << 2)
 
+static JSAtom js_get_error_location_atom(JSContext *ctx)
+{
+    JSRuntime *rt = ctx->rt;
+    JSValue sym;
+
+    if (rt->error_location_atom == JS_ATOM_NULL) {
+        sym = JS_NewPrivateSymbol(ctx, "errorLocation");
+        if (JS_IsException(sym))
+            return JS_ATOM_NULL;
+        rt->error_location_atom = JS_ValueToAtom(ctx, sym);
+        JS_FreeValue(ctx, sym);
+    }
+    return rt->error_location_atom;
+}
+
+/* Record on an error where it was created: the location given for a parse
+   error, or otherwise the innermost frame of the stack that has one. */
+static void record_error_location(JSContext *ctx, JSValueConst error_val,
+                                  JSValueConst filter_func,
+                                  const char *filename, int line_num,
+                                  int col_num, int backtrace_flags)
+{
+    JSStackFrame *sf, *sf_start;
+    JSFunctionBytecode *b;
+    JSValue saved_exception, loc, values[3];
+    JSValue name = JS_UNDEFINED;
+    JSObject *p;
+    JSAtom atom;
+    uint32_t pc;
+
+    if (JS_GetClassID(error_val) != JS_CLASS_ERROR)
+        return;
+    saved_exception = JS_GetException(ctx);
+    if (filename) {
+        name = JS_NewString(ctx, filename);
+    } else {
+        sf_start = ctx->rt->current_stack_frame;
+        if (backtrace_flags & JS_BACKTRACE_FLAG_FILTER_FUNC) {
+            for (sf = sf_start; sf != NULL; sf = sf->prev_frame) {
+                if (js_same_value(ctx, sf->cur_func, filter_func)) {
+                    sf_start = sf;
+                    break;
+                }
+            }
+        }
+        for (sf = sf_start; sf != NULL; sf = sf->prev_frame) {
+            if (backtrace_flags & JS_BACKTRACE_FLAG_SKIP_FIRST_LEVEL) {
+                backtrace_flags &= ~JS_BACKTRACE_FLAG_SKIP_FIRST_LEVEL;
+                continue;
+            }
+            p = JS_VALUE_GET_OBJ(sf->cur_func);
+            if (!js_class_has_bytecode(p->class_id) || !sf->cur_pc)
+                continue;
+            b = p->u.func.function_bytecode;
+            if (!b->filename)
+                continue;
+            pc = sf->cur_pc - b->byte_code_buf - 1;
+            line_num = find_line_num(ctx, b, pc, &col_num);
+            name = JS_AtomToString(ctx, b->filename);
+            break;
+        }
+    }
+    if (JS_IsUndefined(name))
+        goto done;
+    atom = js_get_error_location_atom(ctx);
+    if (atom == JS_ATOM_NULL || JS_IsException(name)) {
+        JS_FreeValue(ctx, name);
+        goto done;
+    }
+    values[0] = name;
+    values[1] = js_int32(line_num);
+    values[2] = js_int32(col_num);
+    loc = JS_NewArrayFrom(ctx, countof(values), values);
+    if (JS_IsException(loc))
+        goto done;
+    JS_DefinePropertyValue(ctx, error_val, atom, loc,
+                           JS_PROP_CONFIGURABLE | JS_PROP_WRITABLE);
+ done:
+    JS_FreeValue(ctx, JS_GetException(ctx));
+    JS_Throw(ctx, saved_exception);
+}
+
+int JS_GetErrorLocation(JSContext *ctx, JSValueConst error,
+                        JSValue *pfilename, int *pline_num, int *pcol_num)
+{
+    JSAtom atom = ctx->rt->error_location_atom;
+    JSValue loc;
+    int line_num, col_num;
+
+    if (atom == JS_ATOM_NULL || JS_GetClassID(error) != JS_CLASS_ERROR)
+        return -1;
+    loc = JS_GetProperty(ctx, error, atom);
+    if (!JS_IsArray(loc)) {
+        JS_FreeValue(ctx, loc);
+        return -1;
+    }
+    if (pfilename)
+        *pfilename = JS_GetPropertyUint32(ctx, loc, 0);
+    JS_ToInt32Free(ctx, &line_num, JS_GetPropertyUint32(ctx, loc, 1));
+    JS_ToInt32Free(ctx, &col_num, JS_GetPropertyUint32(ctx, loc, 2));
+    JS_FreeValue(ctx, loc);
+    if (pline_num)
+        *pline_num = line_num;
+    if (pcol_num)
+        *pcol_num = col_num;
+    return 0;
+}
+
 /* if filename != NULL, an additional level is added with the filename
    and line number information (used for parse error). */
 static void build_backtrace(JSContext *ctx, JSValueConst error_val,
@@ -8256,6 +8369,8 @@ static void build_backtrace(JSContext *ctx, JSValueConst error_val,
     if (rt->in_build_stack_trace)
