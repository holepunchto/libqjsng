+JSValue JS_GetDynamicImportHostDefined(JSContext *ctx, JSValueConst token)
+{
+    return JS_GetPropertyStr(ctx, token, "hostDefined");
+}
+
+static void js_set_host_defined(JSContext *ctx, JSFunctionBytecode *b,
+                                JSValueConst val)
+{
+    int i;
+
+    JS_FreeValue(ctx, b->host_defined);
+    b->host_defined = js_dup(val);
+    for(i = 0; i < b->cpool_count; i++) {
+        if (JS_VALUE_GET_TAG(b->cpool[i]) == JS_TAG_FUNCTION_BYTECODE)
+            js_set_host_defined(ctx, JS_VALUE_GET_PTR(b->cpool[i]), val);
+    }
+}
+
+JSValue JS_GetHostDefined(JSValueConst func_obj)
+{
+    JSObject *p;
+
+    if (JS_VALUE_GET_TAG(func_obj) != JS_TAG_OBJECT)
+        return JS_UNDEFINED;
+    p = JS_VALUE_GET_OBJ(func_obj);
+    if (!js_class_has_bytecode(p->class_id))
+        return JS_UNDEFINED;
+    return js_dup(p->u.func.function_bytecode->host_defined);
+}
+
+int JS_SetHostDefined(JSContext *ctx, JSValueConst obj, JSValueConst val)
+{
+    JSValueConst func_obj = obj;
+    JSObject *p;
+
+    if (JS_VALUE_GET_TAG(obj) == JS_TAG_MODULE)
+        func_obj = ((JSModuleDef *)JS_VALUE_GET_PTR(obj))->func_obj;
+    switch(JS_VALUE_GET_TAG(func_obj)) {
+    case JS_TAG_FUNCTION_BYTECODE:
+        js_set_host_defined(ctx, JS_VALUE_GET_PTR(func_obj), val);
+        return 0;
+    case JS_TAG_OBJECT:
+        p = JS_VALUE_GET_OBJ(func_obj);
+        if (!js_class_has_bytecode(p->class_id))
+            break;
+        js_set_host_defined(ctx, p->u.func.function_bytecode, val);
+        return 0;
+    }
+    JS_ThrowTypeError(ctx, "not a compiled script, module or function");
+    return -1;
+}
+
 int JS_FinishDynamicImport(JSContext *ctx, JSValue token, JSValue promise,
                            JSValue exception)
 {
@@ -37317,6 +37387,7 @@ static JSValue js_create_function(JSContext *ctx, JSFunctionDef *fd)
     b = js_mallocz(ctx, function_size);
