diff --git a/quickjs.c b/quickjs.c
index c7f36d2..d05e342 100644
--- a/quickjs.c
+++ b/quickjs.c
@@ -38692,6 +38692,27 @@ int JS_ResolveModule(JSContext *ctx, JSValueConst obj)
     return 0;
 }
 
+int JS_LinkModule(JSContext *ctx, JSValueConst obj)
+{
+    JSModuleDef *m;
+
+    if (JS_VALUE_GET_TAG(obj) != JS_TAG_MODULE) {
+        JS_ThrowTypeError(ctx, "not a module");
+        return -1;
+    }
+    m = JS_VALUE_GET_PTR(obj);
+    if (m->status == JS_MODULE_STATUS_LINKING ||
+        m->status == JS_MODULE_STATUS_EVALUATING) {
+        JS_ThrowTypeError(ctx, "module is being linked or evaluated");
+        return -1;
+    }
+    if (JS_ResolveModule(ctx, obj) < 0)
+        return -1;
+    if (js_create_module_function(ctx, m) < 0)
+        return -1;
+    return js_link_module(ctx, m);
+}
+
 /*******************************************************************/
 /* object list */
 
@@ -39202,6 +39223,7 @@ static int JS_WriteFunctionTag(BCWriterState *s, JSValueConst obj)
 static int JS_WriteModule(BCWriterState *s, JSValueConst obj)
 {
     JSModuleDef *m = JS_VALUE_GET_PTR(obj);
+    JSValueConst func_obj;
     int i;
 
     bc_put_u8(s, BC_TAG_MODULE);
@@ -39242,7 +39264,13 @@ static int JS_WriteModule(BCWriterState *s, JSValueConst obj)
 
     bc_put_u8(s, m->has_tla);
 
-    if (JS_WriteObjectRec(s, m->func_obj))
+    /* a linked module holds a function object in place of its bytecode */
+    func_obj = m->func_obj;
+    if (JS_VALUE_GET_TAG(func_obj) == JS_TAG_OBJECT) {
+        func_obj = JS_MKPTR(JS_TAG_FUNCTION_BYTECODE,
+                            JS_VALUE_GET_OBJ(func_obj)->u.func.function_bytecode);
+    }
+    if (JS_WriteObjectRec(s, func_obj))
         goto fail;
     return 0;
  fail:
