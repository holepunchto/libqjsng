     js_free_rt(rt, wr);
 }
 
-static JSValue js_weakref_constructor(JSContext *ctx, JSValueConst new_target,
-                                      int argc, JSValueConst *argv)
+static JSValue js_weakref_init(JSContext *ctx, JSValue obj, JSValueConst target)
 {
-    if (JS_IsUndefined(new_target))
-        return JS_ThrowTypeError(ctx, "constructor requires 'new'");
-    JSValueConst arg = argv[0];
-    if (!is_valid_weakref_target(arg))
-        return JS_ThrowTypeError(ctx, "invalid target");
-    // TODO(saghul): short-circuit if the refcount is 1?
-    JSValue obj = js_create_from_ctor(ctx, new_target, JS_CLASS_WEAK_REF);
     if (JS_IsException(obj))
         return JS_EXCEPTION;
     JSWeakRefData *wrd = js_malloc(ctx, sizeof(*wrd));
@@ -63660,24 +63652,51 @@ static JSValue js_weakref_constructor(JSContext *ctx, JSValueConst new_target,
         js_free(ctx, wrd);
         return JS_EXCEPTION;
     }
-    wrd->target = arg;
+    wrd->target = target;
     wrd->obj = obj;
     wr->kind = JS_WEAK_REF_KIND_WEAK_REF;
     wr->u.weak_ref_data = wrd;
-    insert_weakref_record(arg, wr);
+    insert_weakref_record(target, wr);
 
     JS_SetOpaqueInternal(obj, wrd);
     return obj;
 }
 
+static JSValue js_weakref_constructor(JSContext *ctx, JSValueConst new_target,
+                                      int argc, JSValueConst *argv)
+{
+    if (JS_IsUndefined(new_target))
+        return JS_ThrowTypeError(ctx, "constructor requires 'new'");
+    JSValueConst arg = argv[0];
+    if (!is_valid_weakref_target(arg))
+        return JS_ThrowTypeError(ctx, "invalid target");
+    // TODO(saghul): short-circuit if the refcount is 1?
+    JSValue obj = js_create_from_ctor(ctx, new_target, JS_CLASS_WEAK_REF);
+    return js_weakref_init(ctx, obj, arg);
+}
+
+JSValue JS_NewWeakRef(JSContext *ctx, JSValueConst target)
+{
+    if (!is_valid_weakref_target(target))
+        return JS_ThrowTypeError(ctx, "invalid target");
+    JSValue obj = JS_NewObjectClass(ctx, JS_CLASS_WEAK_REF);
+    return js_weakref_init(ctx, obj, target);
+}
+
+JSValue JS_GetWeakRefTarget(JSContext *ctx, JSValueConst val)
+{
+    JSWeakRefData *wrd = JS_GetOpaque(val, JS_CLASS_WEAK_REF);
+    if (!wrd || wrd == &js_weakref_sentinel)
+        return JS_UNDEFINED;
+    return js_dup(wrd->target);
+}
+
 static JSValue js_weakref_deref(JSContext *ctx, JSValueConst this_val, int argc, JSValueConst *argv)
 {
     JSWeakRefData *wrd = JS_GetOpaque2(ctx, this_val, JS_CLASS_WEAK_REF);
     if (!wrd)
         return JS_EXCEPTION;
-    if (wrd == &js_weakref_sentinel)
-        return JS_UNDEFINED;
-    return js_dup(wrd->target);
+    return JS_GetWeakRefTarget(ctx, this_val);
 }
 
