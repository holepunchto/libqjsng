diff --git a/quickjs.c b/quickjs.c
index 8cbc85e..b6c91d4 100644
--- a/quickjs.c
+++ b/quickjs.c
@@ -12060,6 +12060,68 @@ bool JS_IsDataView(JSValueConst val)
     return JS_CLASS_DATAVIEW == JS_GetClassID(val);
 }
 
+bool JS_IsSharedArrayBuffer(JSValueConst val)
+{
+    return JS_CLASS_SHARED_ARRAY_BUFFER == JS_GetClassID(val);
+}
+
+bool JS_IsGeneratorFunction(JSValueConst val)
+{
+    return JS_CLASS_GENERATOR_FUNCTION == JS_GetClassID(val);
+}
+
+bool JS_IsGenerator(JSValueConst val)
+{
+    return JS_CLASS_GENERATOR == JS_GetClassID(val);
+}
+
+bool JS_IsMapIterator(JSValueConst val)
+{
+    return JS_CLASS_MAP_ITERATOR == JS_GetClassID(val);
+}
+
+bool JS_IsSetIterator(JSValueConst val)
+{
+    return JS_CLASS_SET_ITERATOR == JS_GetClassID(val);
+}
+
+bool JS_IsModuleNamespace(JSValueConst val)
+{
+    return JS_CLASS_MODULE_NS == JS_GetClassID(val);
+}
+
+bool JS_IsBooleanObject(JSValueConst val)
+{
+    return JS_CLASS_BOOLEAN == JS_GetClassID(val);
+}
+
+bool JS_IsNumberObject(JSValueConst val)
+{
+    return JS_CLASS_NUMBER == JS_GetClassID(val);
+}
+
+bool JS_IsStringObject(JSValueConst val)
+{
+    return JS_CLASS_STRING == JS_GetClassID(val);
+}
+
+bool JS_IsSymbolObject(JSValueConst val)
+{
+    return JS_CLASS_SYMBOL == JS_GetClassID(val);
+}
+
+bool JS_IsBigIntObject(JSValueConst val)
+{
+    return JS_CLASS_BIG_INT == JS_GetClassID(val);
+}
+
+bool JS_IsArguments(JSValueConst val)
+{
+    JSClassID class_id = JS_GetClassID(val);
+    return class_id == JS_CLASS_ARGUMENTS ||
+           class_id == JS_CLASS_MAPPED_ARGUMENTS;
+}
+
 bool JS_IsError(JSValueConst val)
 {
     return JS_CLASS_ERROR == JS_GetClassID(val);
